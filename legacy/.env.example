# --- Local free mode (current) ---
OPENAI_API_KEY=ollama
STT_MODEL_PATH=models/ggml-large-v3-turbo-q5_0.bin
STT_THREADS=8
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL=qwen3:8b
LLM_VISION_MODEL=qwen2.5vl:3b
LANGUAGES=English, Russian and Uzbek
LANGUAGE=auto
SYSTEM_AUDIO=1

# LANGUAGE: auto | en | ru | uz — для STT; в UI выбирается в оверлее
# LANGUAGES — какие языки может использовать общение (в промпт LLM)
# Для скриншотов используется LLM_VISION_MODEL: ollama pull qwen2.5vl:3b

# --- Cloud mode (OpenAI-compatible) ---
# OPENAI_API_KEY=sk-...
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# LANGUAGE=en
# PERSONA=I am a candidate in a job interview. Help me answer questions clearly and concisely.
